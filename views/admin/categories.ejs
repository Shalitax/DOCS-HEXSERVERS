<%
  const headerButtons = `
    <button onclick="showCategoryModal()" class="bg-gradient-to-r from-green-500 to-emerald-500 px-4 py-2 rounded-lg hover:from-green-600 hover:to-emerald-600 transition-all text-white font-semibold">
      <i class="fas fa-plus mr-2"></i>Nueva Categoría
    </button>
  `;
%>
<%- include('../partials/admin-head', { pageTitle: 'Gestión de Categorías' }) %>
<%- include('../partials/admin-header', { 
  headerTitle: 'Gestión de Categorías',
  headerButtons: headerButtons,
  showBackButton: true 
}) %>

  <div class="container mx-auto px-6 py-8">
    
    <div class="grid gap-6">
      <% categories.forEach(category => { %>
        <div class="glass rounded-xl p-6 border border-white/20 shadow-xl">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center space-x-3">
              <% if (category.icon_type === 'image' && category.icon) { %>
                <img src="<%= category.icon %>" alt="<%= category.display_name %>" class="w-8 h-8 object-contain" onerror="this.style.display='none'">
              <% } else { %>
                <i class="<%= category.icon.includes(' ') ? category.icon : 'fas ' + category.icon %> text-purple-400 text-2xl"></i>
              <% } %>
              <div>
                <h3 class="text-xl font-bold"><%= category.display_name %></h3>
                <p class="text-sm text-gray-400">
                  Slug: <%= category.slug %> | Orden: <%= category.order_index %>
                  <% if (category.is_hidden) { %>
                    <span class="ml-2 px-2 py-1 bg-yellow-500/20 text-yellow-400 rounded text-xs">
                      <i class="fas fa-eye-slash mr-1"></i>Oculto
                    </span>
                  <% } %>
                </p>
              </div>
            </div>
            <div class="flex space-x-2">
              <button onclick="showSubcategoryModal(<%= category.id %>, '<%= category.display_name.replace(/'/g, "\\'") %>')" class="glass px-3 py-2 rounded hover:bg-green-500/20 text-green-400 transition-all font-medium">
                <i class="fas fa-plus mr-1"></i>Subcategoría
              </button>
              <button onclick="editCategory(<%= category.id %>, '<%= category.name.replace(/'/g, "\\'") %>', '<%= category.display_name.replace(/'/g, "\\'") %>', '<%= category.slug %>', '<%= category.icon.replace(/'/g, "\\'") %>', <%= category.order_index %>, <%= category.is_hidden ? 1 : 0 %>, '<%= category.icon_type || 'fontawesome' %>')" class="glass px-3 py-2 rounded hover:bg-blue-500/20 text-blue-400 transition-all">
                <i class="fas fa-edit"></i>
              </button>
              <button onclick="deleteCategory(<%= category.id %>, '<%= category.display_name.replace(/'/g, "\\'") %>')" class="glass px-3 py-2 rounded hover:bg-red-500/20 text-red-400 transition-all">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </div>
          
          <!-- Subcategorías -->
          <% if (category.subcategories && category.subcategories.length > 0) { %>
            <div class="ml-6 mt-4 space-y-2 border-l-2 border-white/10 pl-4">
              <%- include('../partials/admin-subcategory-tree', { subcategories: category.subcategories, category: category }) %>
            </div>
          <% } %>
        </div>
      <% }); %>

      <% if (categories.length === 0) { %>
        <div class="glass rounded-xl p-8 border border-white/20 text-center text-gray-400 shadow-xl">
          No hay categorías disponibles. <button onclick="showCategoryModal()" class="text-purple-400 hover:underline">Crea la primera</button>
        </div>
      <% } %>
    </div>

  </div>

  <%- include('../partials/admin-category-modals') %>
  <%- include('../partials/admin-modals') %>

<%- include('../partials/admin-footer', { 
  extraScripts: `<script src="/js/main.js"></script>` 
}) %>
